@model QuestionViewModel
@{
    ViewData["Title"] = "Create Question";
}

<h2 class="mb-4">Create New Question</h2>

<form asp-action="Save" method="post" >

    <div class="row g-3">
        <div class="col-md-12">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ChoiceA" class="form-label">Choice A</label>
            <input asp-for="ChoiceA" class="form-control" />
            <span asp-validation-for="ChoiceA" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ChoiceB" class="form-label">Choice B</label>
            <input asp-for="ChoiceB" class="form-control" />
            <span asp-validation-for="ChoiceB" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ChoiceC" class="form-label">Choice C</label>
            <input asp-for="ChoiceC" class="form-control" />
            <span asp-validation-for="ChoiceC" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ChoiceD" class="form-label">Choice D</label>
            <input asp-for="ChoiceD" class="form-control" />
            <span asp-validation-for="ChoiceD" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="CorrectAnswer" class="form-label">Correct Answer (A, B, C, D)</label>
            <input asp-for="CorrectAnswer" class="form-control" />
            <span asp-validation-for="CorrectAnswer" class="text-danger"></span>
        </div>

        <div class="col-md-8">
            <label asp-for="SelectedExams" class="form-label">Exams</label>
            <select asp-for="SelectedExams" asp-items="Model.Exams" class="form-select" multiple>
            </select>
            <span asp-validation-for="SelectedExams" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
