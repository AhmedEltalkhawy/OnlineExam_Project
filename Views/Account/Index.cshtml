@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "All Users";
}

<div class="mb-3"></div>

<div class="d-flex flex-wrap justify-content-center gap-3 my-5">

    <a class="btn btn-success btn-lg" asp-action="Register">
        Add New User
    </a>

    <a class="btn btn-info btn-lg" asp-action="Index" >
        All Users
    </a>

    

    
    <a class="btn btn-primary btn-lg" asp-action="Admins" >
        Admins
    </a>
    <a class="btn btn-primary btn-lg" asp-action="Students" >
        Students
    </a>


</div>

<form method="get" asp-action="Search" class="mb-4">
    <div class="d-flex flex-wrap justify-content-center gap-3 my-5">
        <div class="col-auto">
            <label for="Name" class="col-form-label">Enter Order Name :</label>
        </div>
        <div class="col-auto">
            <input type="text" id="Name" name="Name" class="form-control" placeholder="Search by name" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </div>
    </div>
</form>



@if (!Model.Any())
{
    <div class="alert alert-warning mt-5 text-center">
        <h4 class="alert-heading">No Users!</h4>
        <p class="mb-0">No Users have been added yet.</p>
    </div>
}
else
{
    <div class="container mt-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white">
                <h3 class="text-center mb-0">User List</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>

                                <th>ID</th>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>IsAdmin</th>
                                <th>Status</th>
                                <th>Actions</th>

                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Id</td>
                                    <td class="text-start fw-semibold">@user.UserName</td>
                                    <td class="text-start">@user.PhoneNumber</td>
                                    <td>@user.IsAdmin</td>

                                    <td>
                                        @if (user.IsDeleted)
                                        {
                                            <span class="badge bg-danger">Deleted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                   
                                    <td>



                                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-Name="@user.UserName" title="Delete User">
                                            Delete
                                        </a>

                                        <a class="btn btn-sm btn-warning" asp-action="UndoDelete" asp-route-Name="@user.UserName" title="UndoDelete User">
                                            UndoDelete
                                        </a>

 

                                    </td>
                                </tr>
                            }




                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

