
@model List<Exam>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2> Exams </h2>
    </div>

    <form method="get" asp-action="Search" class="mb-4">
        <div class="d-flex flex-wrap justify-content-center gap-3 my-5">
            <div class="col-auto">
                <label for="Name" class="col-form-label">Enter Exam Name :</label>
            </div>
            <div class="col-auto">
                <input type="text" id="Name" name="Name" class="form-control" placeholder="Search by name" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Search</button>
            </div>
        </div>
    </form>

    <div class="row">
        @foreach (var exam in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@exam.Title</h5>
                        <p class="card-text">

                            <strong>Description:</strong> @exam.Description <br />
                            <strong>No Of Questions:</strong> @(exam.Questions.Count )


                        </p>

                        <div class="container my-5">
                            <div class="card shadow-sm border-0 p-4 text-center">
                                <h5 class="mb-4 text-success">Exam Actions</h5>
                                <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                                    <a asp-controller="Exam" asp-action="TakeExam" asp-route-id="@exam.Id" class="btn btn-outline-success btn-lg">
                                       Take Exam (All Questions)
                                    </a>
                                    <a asp-controller="Exam" asp-action="StartExam" asp-route-examId="@exam.Id" class="btn btn-outline-warning btn-lg">
                                        Take Exam (AJAX)
                                    </a>
                                    <a asp-controller="Exam" asp-action="Result" asp-route-ExamId="@exam.Id" class="btn btn-outline-primary btn-lg">
                                        View Result
                                    </a>
                                </div>
                            </div>
                        </div>


                        @* <div class="d-flex flex-wrap justify-content-center gap-3 my-5"> *@

                        @*     <a asp-controller="Exam" asp-action="TakeExam" asp-route-id="@exam.Id" class="btn btn-success btn-sm"> Take Exam ALL Questions </a> *@
                        @*     <a asp-controller="Exam" asp-action="StartExam" asp-route-examId="@exam.Id" class="btn btn-success btn-sm"> Take Exam Using AJAX </a> *@
                        @*     <a asp-controller="Exam" asp-action="Result" asp-route-ExamId="@exam.Id" class="btn btn-primary btn-sm"> View Result </a> *@

                        @* </div> *@


                    </div>
                </div>
            </div>
        }
    </div>
</div>

